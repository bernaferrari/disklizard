{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "disklizard",
  "description": "Developer-aware disk space explorer and safe cleanup utility",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:disklizard": "bun packages/disklizard/bin/disklizard.ts",
    "disklizard": "bun packages/disklizard/bin/disklizard.ts",
    "lint": "oxlint --quiet packages/disklizard/src packages/disklizard/bin packages/ui/src packages/app/src/disklizard.ts packages/app/src/disklizard-i18n.ts packages/app/src/context/language.tsx packages/app/src/i18n packages/app/src/pages/disk-utility packages/app/scripts packages/app/e2e/disk-utility packages/app/disklizard-public packages/app/vite.js packages/desktop/src packages/desktop/scripts packages/desktop/electron-builder.config.ts packages/desktop/electron.vite.config.ts scripts/test-disklizard.ts",
    "typecheck": "bun run --cwd packages/disklizard typecheck && bun run --cwd packages/ui typecheck && bun run --cwd packages/app typecheck && bun run --cwd packages/desktop typecheck",
    "test:disklizard": "bun ./scripts/test-disklizard.ts",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/app",
      "packages/desktop",
      "packages/disklizard",
      "packages/ui"
    ],
    "catalog": {
      "@axe-core/playwright": "4.13.0",
      "@kobalte/core": "0.13.11",
      "@pierre/diffs": "1.2.10",
      "@playwright/test": "1.59.1",
      "@sentry/vite-plugin": "4.6.0",
      "@shikijs/stream": "4.2.0",
      "@solid-primitives/storage": "4.3.3",
      "@solidjs/meta": "0.29.4",
      "@tailwindcss/vite": "4.1.11",
      "@tanstack/solid-virtual": "3.13.32",
      "@tsconfig/bun": "1.0.9",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.3.13",
      "@types/luxon": "3.7.1",
      "@types/node": "24.12.2",
      "@typescript/native-preview": "7.0.0-dev.20251207.1",
      "diff": "8.0.3",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "18.0.7",
      "marked-shiki": "1.2.1",
      "remeda": "2.26.0",
      "remend": "1.3.0",
      "shiki": "4.2.0",
      "solid-js": "1.9.12",
      "solid-list": "0.3.0",
      "solid-sonner": "0.3.1",
      "tailwindcss": "4.1.11",
      "typescript": "5.8.2",
      "vite": "7.3.6",
      "vite-plugin-solid": "2.11.10"
    }
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxlint": "1.60.0",
    "oxlint-tsgolint": "0.21.0",
    "prettier": "3.6.2"
  },
  "dependencies": {},
  "repository": "https://github.com/bernaferrari/disklizard",
  "license": "MIT",
  "prettier": {
    "semi": false,
    "printWidth": 120
  },
  "trustedDependencies": [
    "esbuild",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "brace-expansion@>=1 <2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=4 <6": "5.0.9",
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "js-yaml@>=3 <4": "3.15.1",
    "js-yaml@>=4 <5": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tar": "7.5.22",
    "undici@>=6 <7": "6.28.0",
    "undici@>=7 <8": "7.29.0",
    "undici@>=8 <9": "8.10.0",
    "ws": "8.21.3"
  },
  "patchedDependencies": {
    "@tanstack/virtual-core@3.17.3": "patches/@tanstack%2Fvirtual-core@3.17.3.patch",
    "solid-js@1.9.12": "patches/solid-js@1.9.12.patch"
  }
}
