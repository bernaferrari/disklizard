{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "disklizard",
  "description": "Developer-aware disk space explorer and safe cleanup utility",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev:desktop": "bun --cwd packages/desktop dev",
    "dev:disklizard": "bun packages/disklizard/bin/disklizard.ts",
    "disklizard": "bun packages/disklizard/bin/disklizard.ts",
    "lint": "bun run --cwd packages/app lint",
    "format": "bun run --cwd packages/app format",
    "format:check": "bun run --cwd packages/app format:check",
    "typecheck": "bun run --cwd packages/disklizard typecheck && bun run --cwd packages/app typecheck && bun run --cwd packages/desktop typecheck",
    "test:disklizard": "bun ./scripts/test-disklizard.ts",
    "test": "echo 'do not run tests from root' && exit 1"
  },
  "workspaces": {
    "packages": [
      "packages/app",
      "packages/desktop",
      "packages/disklizard"
    ],
    "catalog": {
      "@axe-core/playwright": "4.13.0",
      "@pierre/diffs": "1.2.10",
      "@playwright/test": "1.63.0",
      "@sentry/vite-plugin": "4.6.0",
      "@shikijs/stream": "4.2.0",
      "@tailwindcss/vite": "4.3.3",
      "@tsconfig/bun": "1.0.11",
      "@tsconfig/node22": "22.0.2",
      "@types/bun": "1.4.2",
      "@types/luxon": "3.7.1",
      "@types/node": "26.6.2",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "diff": "8.0.3",
      "fuzzysort": "3.1.0",
      "luxon": "3.6.1",
      "marked": "18.0.7",
      "marked-shiki": "1.2.1",
      "remeda": "2.26.0",
      "remend": "1.3.0",
      "shiki": "4.2.0",
      "tailwindcss": "4.1.11",
      "typescript": "7.0.2",
      "vite": "7.3.6"
    }
  },
  "devDependencies": {
    "@shadcn/lint": "0.2.0",
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "husky": "9.1.7",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2002"
  },
  "dependencies": {},
  "repository": "https://github.com/bernaferrari/disklizard",
  "license": "MIT",
  "trustedDependencies": [
    "esbuild",
    "electron"
  ],
  "overrides": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "brace-expansion@>=1 <2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=4 <6": "5.0.9",
    "fast-uri": "3.1.5",
    "form-data": "4.0.6",
    "ip-address": "10.5.0",
    "js-yaml@>=3 <4": "3.15.1",
    "js-yaml@>=4 <5": "4.3.1",
    "nanoid": "3.3.18",
    "postcss": "8.5.26",
    "tar": "7.5.22",
    "undici@>=6 <7": "6.28.0",
    "undici@>=7 <8": "7.29.0",
    "undici@>=8 <9": "8.10.0",
    "ws": "8.21.3"
  }
}
