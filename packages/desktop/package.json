{
  "name": "disklizard-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "description": "Developer-aware disk space explorer and safe cleanup utility",
  "homepage": "https://github.com/bernaferrari/disklizard",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bernaferrari/disklizard.git"
  },
  "bugs": "https://github.com/bernaferrari/disklizard/issues",
  "author": "DiskLizard contributors",
  "scripts": {
    "typecheck": "tsgo -b",
    "predev": "bun ./scripts/predev.ts",
    "dev": "electron-vite dev",
    "prebuild": "bun ./scripts/prebuild.ts",
    "build": "electron-vite build",
    "build:packaged-smoke": "bun ./scripts/build-packaged-smoke.ts",
    "preview": "electron-vite preview",
    "package": "bun ./scripts/build-and-package.ts",
    "package:dir": "bun ./scripts/build-and-package.ts --dir",
    "package:smoke": "bun ./scripts/packaged-smoke-pipeline.ts --package-only",
    "verify:packaged-smoke": "bun ./scripts/packaged-smoke-pipeline.ts",
    "package:mac": "bun ./scripts/build-and-package.ts --mac",
    "package:win": "bun ./scripts/build-and-package.ts --win",
    "package:linux": "bun ./scripts/build-and-package.ts --linux",
    "native:build": "bun ../disklizard/scripts/build-native.ts",
    "smoke:native-worker": "bun ./scripts/smoke-native-worker-bundle.ts",
    "smoke:packaged": "tsx ./scripts/run-packaged-smoke.ts",
    "benchmark:disk": "bun ./scripts/benchmark-disk-scan.ts",
    "benchmark:snapshots": "bun ./scripts/benchmark-disk-snapshots.ts",
    "test:disklizard": "bun ../../scripts/test-disklizard.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@parcel/watcher": "2.5.1",
    "@zip.js/zip.js": "2.7.62",
    "electron-context-menu": "4.1.2",
    "electron-log": "^5",
    "electron-store": "11.0.2",
    "electron-updater": "6.8.9",
    "electron-window-state": "^5.0.3"
  },
  "devDependencies": {
    "@disklizard/app": "workspace:*",
    "@disklizard/core": "workspace:*",
    "@electron/asar": "3.4.1",
    "@xmldom/xmldom": "0.8.14",
    "@opencode-ai/ui": "workspace:*",
    "@playwright/test": "catalog:",
    "@solid-primitives/storage": "catalog:",
    "@solidjs/meta": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "app-builder-lib": "26.15.7",
    "electron": "42.9.3",
    "electron-builder": "26.15.7",
    "electron-builder-squirrel-windows": "26.15.7",
    "electron-vite": "^5",
    "solid-js": "catalog:",
    "tsx": "4.23.12",
    "tw-animate-css": "1.4.0",
    "typescript": "~5.6.2",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  },
  "optionalDependencies": {
    "@parcel/watcher-darwin-arm64": "2.5.1",
    "@parcel/watcher-darwin-x64": "2.5.1",
    "@parcel/watcher-linux-arm64-glibc": "2.5.1",
    "@parcel/watcher-linux-arm64-musl": "2.5.1",
    "@parcel/watcher-linux-x64-glibc": "2.5.1",
    "@parcel/watcher-linux-x64-musl": "2.5.1",
    "@parcel/watcher-win32-arm64": "2.5.1",
    "@parcel/watcher-win32-x64": "2.5.1"
  }
}
