{
  "name": "@disklizard/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Shared disk space map — fast scanner + viz primitives for Desktop & TUI",
  "exports": {
    ".": "./src/index.ts",
    "./scan": "./src/scan.ts",
    "./format": "./src/format.ts",
    "./safety": "./src/safety.ts",
    "./tree": "./src/tree.ts",
    "./tui": "./src/tui/app.ts",
    "./cli": "./src/cli.ts",
    "./backend": "./src/backend.ts",
    "./native": "./src/native.ts"
  },
  "bin": {
    "disklizard": "./bin/disklizard.ts"
  },
  "scripts": {
    "start": "bun ./bin/disklizard.ts",
    "tui": "bun ./bin/disklizard.ts",
    "native:build": "bun ./scripts/build-native.ts",
    "native:test": "cargo test --manifest-path ./native-scanner/Cargo.toml",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:"
  }
}
