{
  "name": "@disklizard/app",
  "version": "0.1.0",
  "description": "Standalone DiskLizard storage interface and renderer runtime",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/disklizard.ts",
    "./choose-folder": "./src/pages/disk-utility/choose-folder.ts",
    "./i18n": "./src/disklizard-i18n.ts",
    "./native-i18n": "./src/i18n/desktop-native.ts",
    "./runtime": "./src/pages/disk-utility/runtime.tsx",
    "./styles.css": "./src/disklizard.css",
    "./types": "./src/pages/disk-utility/types.ts",
    "./vite": "./vite.js"
  },
  "scripts": {
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsgo -p e2e/disk-utility/tsconfig.json",
    "check:standalone": "bun ./scripts/check-standalone-boundary.ts",
    "dev": "vite --config e2e/disk-utility/vite.config.ts",
    "build": "vite build --config e2e/disk-utility/vite.config.ts",
    "test": "bun run test:unit && bun run check:standalone",
    "test:unit": "bun test --conditions=solid --only-failures --preload ./happydom.ts ./src/pages/disk-utility ./src/i18n/desktop-native.test.ts ./src/i18n/parity.test.ts",
    "test:e2e": "playwright test --config e2e/disk-utility/playwright.config.ts",
    "test:e2e:disk": "playwright test --config e2e/disk-utility/playwright.config.ts",
    "benchmark:disk-ui": "playwright test --config e2e/disk-utility/playwright.benchmark.config.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@disklizard/core": "workspace:*",
    "@opencode-ai/ui": "workspace:*",
    "@solid-primitives/i18n": "2.2.1",
    "@solid-primitives/storage": "catalog:",
    "@tanstack/solid-virtual": "catalog:",
    "solid-js": "catalog:",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@happy-dom/global-registrator": "20.0.11",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-solid": "catalog:"
  }
}
