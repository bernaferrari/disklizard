{
  "name": "@disklizard/app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "bun test --preload ./happydom.ts src/core src/i18n src/pages/disk-utility",
    "test:unit": "bun test --preload ./happydom.ts src/core src/i18n src/pages/disk-utility"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-virtual": "^3.14.10",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.41.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@happy-dom/global-registrator": "^20.14.0",
    "@types/bun": "^1.4.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8"
  },
  "description": "DiskLizard React storage interface",
  "exports": {
    ".": "./src/disklizard.ts",
    "./runtime": "./src/pages/disk-utility/runtime.tsx",
    "./types": "./src/pages/disk-utility/types.ts",
    "./choose-folder": "./src/pages/disk-utility/choose-folder.ts",
    "./native-i18n": "./src/i18n/desktop-native.ts",
    "./styles.css": "./src/index.css"
  }
}
