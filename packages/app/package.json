{
  "name": "@disklizard/app",
  "version": "0.1.0",
  "private": true,
  "description": "DiskLizard React storage interface",
  "type": "module",
  "exports": {
    ".": "./src/disklizard.ts",
    "./runtime": "./src/pages/disk-utility/runtime.tsx",
    "./types": "./src/pages/disk-utility/types.ts",
    "./choose-folder": "./src/pages/disk-utility/choose-folder.ts",
    "./native-i18n": "./src/i18n/desktop-native.ts",
    "./styles.css": "./src/index.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint .",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit -p tsconfig.src.json && tsc --noEmit -p tsconfig.test.json",
    "preview": "vite preview",
    "test": "bun test --preload ./happydom.ts src/core src/i18n src/pages/disk-utility",
    "test:unit": "bun test --preload ./happydom.ts src/core src/i18n src/pages/disk-utility"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-virtual": "3.14.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "framer-motion": "13.4.0",
    "lucide-react": "1.47.0",
    "next-themes": "0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "20.14.5",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "7.0.2",
    "typescript-compiler": "npm:typescript@5.8.2",
    "vite": "7.3.6"
  }
}
